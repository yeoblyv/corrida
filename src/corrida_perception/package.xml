  <version>0.0.0</version>
  <description>Perception components for the Corrida maze robot</description>
  <maintainer email="nwadikedaniel6@gmail.com">daniel</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
